{
  "expo": {
    "name": "Hamro Exam",
    "slug": "hamro-exam-app",
    "scheme": "hamroexam",
    "version": "1.0.0",
    "android": { "package": "com.prakash.hamroexam" },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hamroexam.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.prakash.hamroexam"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "30466789-e66a-4b4c-bd22-07457b023244"
      }
    },
    "owner": "pk_1"
  }
}
